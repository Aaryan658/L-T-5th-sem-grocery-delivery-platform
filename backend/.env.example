# Copy this file to .env and fill in your own values. Never commit the real .env.

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/grocery_delivery

# Or MongoDB Atlas (replace <user>, <password>, <cluster>)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grocery_delivery?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=1d
SALT_ROUNDS=10
